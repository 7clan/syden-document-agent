# Choose gemini, openai, groq, ollama_cloud, or compatible. Gemini is the default.
# Groq hosts Llama models via an OpenAI-compatible API (no local GPU needed).
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Optional: hosted Llama via Groq (pip install -e ".[openai,dev]").
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_BASE_URL=https://api.groq.com/openai/v1
# Ollama direct cloud API; select a cloud model verified to support tool calls.
OLLAMA_API_KEY=
OLLAMA_MODEL=gpt-oss:20b-cloud
OLLAMA_BASE_URL=https://ollama.com/v1
# For another Chat Completions-compatible Llama host (e.g. Together), check endpoint/tool support.
COMPATIBLE_API_KEY=
COMPATIBLE_MODEL=
COMPATIBLE_BASE_URL=
# Local SQLite file (ignored by Git).
SYDEN_DB_PATH=.local/syden_documents.db
# Maximum file size before warning and skip (MiB), configurable.
SYDEN_MAX_FILE_MB=100
